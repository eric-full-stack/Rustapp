# Server
PORT=3001
NODE_ENV=production

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=generate-a-random-64-char-string-here
ENCRYPTION_KEY=generate-a-random-32-char-hex-key

# Default admin credentials (created on first run)
ADMIN_USER=admin
ADMIN_PASS=changeme

# Monitoring intervals (ms)
FPS_POLL_INTERVAL=30000
PLAYER_POLL_INTERVAL=15000
FPS_DROP_THRESHOLD=0.30
